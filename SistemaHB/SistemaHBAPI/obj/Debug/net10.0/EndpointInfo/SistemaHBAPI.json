{
  "openapi": "3.1.1",
  "info": {
    "title": "SistemaHBAPI | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7176"
    },
    {
      "url": "http://localhost:5050"
    }
  ],
  "paths": {
    "/api/Autenticacion/login": {
      "post": {
        "tags": [
          "Autenticacion"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/LOGINFORMCLS"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LOGINFORMCLS"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LOGINFORMCLS"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LOGINFORMCLS"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Especialidades": {
      "get": {
        "tags": [
          "Especialidades"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Geografia/departamentos": {
      "get": {
        "tags": [
          "Geografia"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Geografia/provincias/{idDepartamento}": {
      "get": {
        "tags": [
          "Geografia"
        ],
        "parameters": [
          {
            "name": "idDepartamento",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Registro/usuario": {
      "post": {
        "tags": [
          "Registro"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/REGISTROFORMCLS"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/REGISTROFORMCLS"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/REGISTROFORMCLS"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/REGISTROFORMCLS"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LOGINFORMCLS": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          }
        }
      },
      "REGISTROFORMCLS": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "apellidoPaterno": {
            "type": "string"
          },
          "apellidoMaterno": {
            "type": "string"
          },
          "genero": {
            "type": "string"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "departamento": {
            "type": "string"
          },
          "provincia": {
            "type": "string"
          },
          "altitud": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "correo": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          },
          "idEspecialidad": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Autenticacion"
    },
    {
      "name": "Especialidades"
    },
    {
      "name": "Geografia"
    },
    {
      "name": "Registro"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}